# Remove the ; to change parameters.

[general]
live-config = 1
framerate = 120
autosens = 1 # increase to make sensitivity increase even faster.
sensitivity = 1000
bars = 0 # 0(auto) - 512
# sdl_glsl have these default values, they are only used to calculate max number of bars.
bar_width = 7
bar_spacing = 5
center_align = 1 # center bars in terminal, if there is space.
max_height = 100 # % of terminal height
lower_cutoff_freq = 65 #65.41 is the start of the second octave # Note: there is a minimum total bandwidth of 43Mhz x number of bars.
higher_cutoff_freq = 8000 # 7982.16 is the end of the eigth octave, cava will increase automatically if needed
sleep_timer = 0 # 0 = disable

[input]
method = pipewire
source = auto
sample_rate = 48000
sample_bits = 32
channels = 2
active = 1 # Force the node to always process.
remix = 1 # remix: Allow pipewire to remix audio channels to match cava's channel count for surround sound.
virtual = 1 # virtual: Set the node to virtual, to avoid recording notifications from the DE.

[output]
method = sdl_glsl
orientation = bottom
channels = stereo # low in center and mirrors higher an the sides
xaxis = none
synchronized_sync = 0 # crashed once maybe this at 1 was responible
vertex_shader = pass_through.vert
fragment_shader = bar_spectrum.frag
; fragment_shader = eye_of_phi.frag
; fragment_shader = northern_lights.frag
; fragment_shader = spectrogram.frag
; fragment_shader = winamp_line_style_spectrum.frag
; fragment_shader = orion_circle.frag
; fragment_shader = orion_circle_rotate.frag
; fragment_shader = orion_saturn_subring.frag
; fragment_shader = orion_saturn_core.frag
continuous_rendering = 1
sdl_glsl_gain = 100 # 0 = mute, 100 = unchanged, >100 = amplify (shader input is clamped to the [0..1] range).
disable_blanking = 1
show_idle_bar_heads = 1

waveform = 0

[color]
background = '#000000'
#foreground = '#33ffff'

# Gradient mode, only hex defined colors are supported,
# background must also be defined in hex or remain commented out. 1 = on, 0 = off.
# You can define as many as 8 different colors. They range from bottom to top of the screen
gradient = 1
 gradient_color_1 = '#59cc33'
 gradient_color_2 = '#80cc33'
 gradient_color_3 = '#a6cc33'
 gradient_color_4 = '#cccc33'
 gradient_color_5 = '#cca633'
 gradient_color_6 = '#cc8033'
 gradient_color_7 = '#cc5933'
 gradient_color_8 = '#ff0000'

# Horizontal is only supported on noncurses output.
; horizontal_gradient = 0
; horizontal_gradient_color_1 = '#c45161'
; horizontal_gradient_color_2 = '#e094a0'
; horizontal_gradient_color_3 = '#f2b6c0'
; horizontal_gradient_color_4 = '#f2dde1'
; horizontal_gradient_color_5 = '#cbc7d8'
; horizontal_gradient_color_6 = '#8db7d2'
; horizontal_gradient_color_7 = '#5e62a9'
; horizontal_gradient_color_8 = '#434279'

# If both vertical and horizontal gradients are enabled, the vertical one will be blended in this direction.
# Can be 'up', 'down', 'left' or 'right'. 'up' means the vertical gradient will be blended in from bottom to top. I.e. the bottom will only be the horizontal and top will only be the vertical color of the gradient.
; blend_direction = 'up'

# use theme file instead of defining colors in this file
# themes are located in $HOME/.config/cava/themes
; theme = 'none'


[smoothing]
; monstercat = 0
; waves = 0

# Noise reduction, int 0 - 100. default 77
# the raw visualization is very noisy, this factor adjusts the integral and gravity filters to keep the signal smooth
# 100 will be very slow and smooth, 0 will be fast but noisy.
; noise_reduction = 77


[eq]

# This one is tricky. You can have as many keys as you want.
# Remember to uncomment more than one key! More keys = more precision.
# Look at readme.md on github for further explanations and examples.
; 1 = 1 # bass
; 2 = 1
; 3 = 1 # midtone
; 4 = 1
; 5 = 1 # treble
